{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "network-relay",
  "main": "index.js",
  "compatibility_date": "2026-11-06",
  "workers_dev": true,
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOMS",
        "class_name": "Room"
      }
    ]
  },
  "exports": {
    "Room": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "observability": {
    "enabled": true
  }
}
